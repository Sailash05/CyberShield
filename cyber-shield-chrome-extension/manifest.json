{
  "manifest_version": 3,
  "name": "Cyber Shield - Phishing Protection",
  "version": "1.0.0",
  "description": "Checks webpage URLs with the Cyber Shield phishing-analysis API.",
  "permissions": [
    "webNavigation",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Cyber Shield Phishing Protection"
  }
}